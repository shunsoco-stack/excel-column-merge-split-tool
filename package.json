{
  "name": "excel-column-merge-split-tool",
  "version": "1.0.0",
  "private": true,
  "description": "ブラウザ内でExcel・CSVの列を結合・分割・並び替えできる業務効率化ツール",
  "scripts": {
    "dev": "next dev --port 3017",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run secret-scan"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
